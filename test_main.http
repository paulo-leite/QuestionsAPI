@baseUrl = http://127.0.0.1:8000
@documentId = substitua-pelo-id-do-upload

GET {{baseUrl}}/health
Accept: application/json

###

# No fluxo principal, arquivos CSV enviado para /documents é auditado
# automaticamente antes da indexação. O relatório vem em data_quality.
POST {{baseUrl}}/documents
Content-Type: multipart/form-data; boundary=DocumentBoundary

--DocumentBoundary
Content-Disposition: form-data; name="file"; filename="dados_atuais.csv"
Content-Type: text/csv

< ./dados_atuais.csv
--DocumentBoundary--

###

# Selecione um CSV no diálogo do IDE. O segundo arquivo é opcional e serve
# como baseline para detectar drift e mudanças de esquema/distribuição.
POST {{baseUrl}}/data-quality/analyze
Content-Type: multipart/form-data; boundary=DataQualityBoundary

--DataQualityBoundary
Content-Disposition: form-data; name="file"; filename="dados_atuais.csv"
Content-Type: text/csv

< ./dados_atuais.csv
--DataQualityBoundary
Content-Disposition: form-data; name="reference_file"; filename="dados_referencia.csv"
Content-Type: text/csv

< ./dados_referencia.csv
--DataQualityBoundary--

###

POST {{baseUrl}}/questions
Content-Type: application/json

{
  "document_id": "{{documentId}}",
  "question": "Qual é o tema principal do documento?"
}

###

POST {{baseUrl}}/research
Content-Type: application/json

{
  "document_id": "{{documentId}}",
  "question": "Apresente as principais conclusões e evidências.",
  "depth": 2
}

###

POST {{baseUrl}}/research/sessions
Content-Type: application/json

{
  "document_id": "{{documentId}}",
  "question": "Analise riscos, benefícios e limitações.",
  "depth": 2
}

###

POST {{baseUrl}}/research/sessions/substitua-pelo-id-da-sessao/clarifications
Content-Type: application/json

{
  "answer": "Priorize riscos técnicos e impactos operacionais."
}
